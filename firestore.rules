
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A user can list the users collection only if they are an admin.
    // This is required for the admin dashboard to display user lists and stats.
    match /users/{document=**} {
        allow list: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    match /users/{userId} {
      // A user can only be created if the person making the request is
      // becoming authenticated and their UID matches the document ID.
      // This secures the user creation process.
      allow create: if request.auth != null && request.auth.uid == userId;

      // Only the authenticated owner of a document can read, update, or delete it.
      // Admins can read any user's profile.
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      
      // Only the owner can update or delete their profile.
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /Activity/{document=**} {
      allow read: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
